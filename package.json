{
  "name": "actual-budget-mcp-es",
  "version": "2.0.0",
  "description": "MCP server for Actual Budget — LLM-ready financial assistant with correct semantics, unit conversion and real split transactions",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "Marco Antonio Pérez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoaperez/actual-budget-mcp-es.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "actual-budget",
    "finance",
    "budgeting",
    "claude"
  ],
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "PRIVACY.md",
    "PRIVACY.es.md",
    "LICENSE"
  ],
  "bin": {
    "actual-budget-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "bundle": "tsx scripts/bundle.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@actual-app/api": "^26.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
